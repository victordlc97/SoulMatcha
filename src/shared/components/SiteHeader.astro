---
import {
  alternateLocale,
  getLocale,
  href,
  localeInfo,
  useTranslations,
  type RouteKey,
} from '../../i18n';
import Logo from './Logo.astro';

interface Props {
  /** Página actual: permite que el selector de idioma lleve a la MISMA página en el otro idioma. */
  routeKey?: RouteKey;
}

const { routeKey = 'home' } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);

const links = [
  { label: t.nav.product, href: href('home', locale, '#producto') },
  { label: t.nav.about, href: href('home', locale, '#nosotros') },
  { label: t.nav.branches, href: href('branches', locale) },
];

// Escritorio: dos enlaces a la izquierda del logo; a la derecha, el tercero y el selector de idioma.
const start = links.slice(0, 2);
const end = links.slice(2);

const other = alternateLocale(locale);
const switchHref = href(routeKey, other);
const switchInfo = localeInfo[other];
---

<header class="site-header">
  <nav class="bar" aria-label={t.a11y.mainNav}>
    <ul class="links start">
      {start.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <a class="brand" href={href('home', locale)} aria-label={t.a11y.goHome}>
      <Logo size="header" />
    </a>

    <ul class="links end">
      {end.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
      <li>
        <a
          class="lang"
          href={switchHref}
          lang={other}
          hreflang={other}
          aria-label={switchInfo.ariaLabel}
        >
          {switchInfo.short}
        </a>
      </li>
    </ul>

    <!-- Solo móvil: abre el panel lateral. En escritorio los enlaces van en la barra. -->
    <button
      type="button"
      class="menu-toggle"
      data-menu-toggle
      aria-label={t.a11y.openMenu}
      aria-haspopup="dialog"
      aria-controls="site-menu"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          d="M4 9h16M4 15h16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </nav>
</header>

<!--
  PANEL LATERAL (móvil). <dialog> modal nativo: atrapa el foco, cierra con Esc y deja el resto
  de la página inerte. Vive fuera de .site-header para no heredar su estado claro/oscuro.
-->
<dialog class="menu" id="site-menu" data-menu aria-label={t.a11y.menuDialog}>
  <div class="menu-top">
    <a
      class="menu-brand"
      href={href('home', locale)}
      aria-label={t.a11y.goHome}
    >
      <Logo size="drawer" />
    </a>

    <button
      type="button"
      class="menu-close"
      data-menu-close
      aria-label={t.a11y.closeMenu}
    >
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <nav aria-label={t.a11y.menuNav}>
    <ul class="menu-links">
      {links.map((link) => (
        <li>
          <a class="menu-link" href={link.href}>
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          class="menu-link menu-lang"
          href={switchHref}
          lang={other}
          hreflang={other}
          aria-label={switchInfo.ariaLabel}
        >
          {switchInfo.name}
        </a>
      </li>
    </ul>
  </nav>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset-block-start: var(--header-offset);
    inset-inline: 0;
    z-index: var(--z-header);
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);

    /* El contenedor no captura clics: solo la barra. */
    pointer-events: none;
  }

  /* Móvil: una sola fila delgada. El logo queda centrado y el botón de menú a la derecha. */
  .bar {
    display: grid;
    grid-template-areas: 'start brand end';
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    inline-size: 100%;
    max-inline-size: 56rem;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    box-shadow: var(--shadow-float);
    pointer-events: auto;
    transition:
      background-color var(--duration-base) var(--ease-out-soft),
      border-color var(--duration-base) var(--ease-out-soft);

    /* stylelint-disable-next-line property-no-vendor-prefix -- Safari < 18 solo entiende la versión con prefijo */
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .bar {
      background: var(--surface-canvas);
    }
  }

  .brand {
    display: flex;
    grid-area: brand;
    justify-self: center;
    border-radius: var(--radius-sm);
  }

  /* En móvil los enlaces viven en el panel lateral. */
  .links {
    display: none;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .start {
    grid-area: start;
    justify-self: start;
  }

  .end {
    grid-area: end;
    justify-self: end;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-base) var(--ease-out-soft);
  }

  .links a:hover {
    background: var(--hover-tint);
  }

  .menu-toggle {
    display: inline-flex;
    grid-area: end;
    align-items: center;
    justify-content: center;
    justify-self: end;
    inline-size: var(--tap-target);
    block-size: var(--tap-target);
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-base) var(--ease-out-soft);
  }

  .menu-toggle:hover {
    background: var(--hover-tint);
  }

  /* Sobre superficies oscuras o de tono medio (hero): cristal oscuro con texto crema.
     Oscurece lo que hay detrás (brightness < 1): un tinte solo no basta, porque el desenfoque
     promedia la foto a un tono medio donde ningún color de texto cumple contraste.
     Ver motion/header-surface.ts. */
  .site-header[data-surface='dark'] .bar {
    border-color: var(--glass-border-dark);
    background: var(--glass-bg-dark);

    /* stylelint-disable-next-line property-no-vendor-prefix -- Safari < 18 */
    -webkit-backdrop-filter: var(--glass-blur-dark);
    backdrop-filter: var(--glass-blur-dark);
  }

  .site-header[data-surface='dark'] .links a,
  .site-header[data-surface='dark'] .menu-toggle {
    color: var(--text-inverse);
  }

  .site-header[data-surface='dark'] .links a:hover,
  .site-header[data-surface='dark'] .menu-toggle:hover {
    background: var(--hover-tint-dark);
  }

  @media (width >= 40rem) {
    .bar {
      padding-inline: var(--space-4);
    }

    .links {
      display: flex;
    }

    .menu-toggle {
      display: none;
    }

    .links a {
      font-size: var(--text-base);
    }
  }

  /* ── Panel lateral ─────────────────────────────── */
  .menu {
    inset-block: 0;
    inset-inline: auto 0;
    inline-size: min(85vw, 22rem);
    block-size: 100dvh;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: var(--space-4) var(--space-6) var(--space-8);
    border: 0;
    border-start-start-radius: var(--radius-lg);
    border-end-start-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-cream) 94%, transparent);
    box-shadow: var(--shadow-float);
    color: var(--text-primary);
    transform: translateX(100%);
    transition:
      transform var(--duration-base) var(--ease-out-soft),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;

    /* stylelint-disable-next-line property-no-vendor-prefix -- Safari < 18 */
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  .menu[open] {
    transform: none;
  }

  @starting-style {
    .menu[open] {
      transform: translateX(100%);
    }
  }

  .menu::backdrop {
    background: color-mix(in srgb, var(--scrim-ink) 55%, transparent);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out-soft),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }

  .menu[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .menu[open]::backdrop {
      opacity: 0;
    }
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-brand {
    display: flex;
    border-radius: var(--radius-sm);
  }

  .menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--tap-target);
    block-size: var(--tap-target);
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }

  .menu-close:hover {
    background: var(--hover-tint);
  }

  .menu-links {
    display: grid;
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Separadores entre enlaces: estructura que agrupa, no decoración. */
  .menu-links li + li {
    border-block-start: 1px solid var(--border-subtle);
  }

  .menu-link {
    display: flex;
    align-items: center;
    min-block-size: calc(var(--tap-target) + var(--space-3));
    color: var(--text-primary);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .menu-link:hover {
    color: var(--text-link);
  }

  /* Selector de idioma: más discreto que un enlace de navegación (es otra clase de acción). */
  .lang {
    letter-spacing: var(--tracking-caps);
  }

  .menu-lang {
    color: var(--text-secondary);
  }
</style>

<script>
  import { initHeaderSurface } from '../motion/header-surface';
  import { initMobileMenu } from '../motion/mobile-menu';

  initHeaderSurface();
  initMobileMenu();
</script>

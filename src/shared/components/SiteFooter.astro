---
import { getLocale, href, useTranslations } from '../../i18n';
import Logo from './Logo.astro';

const locale = getLocale(Astro);
const t = useTranslations(locale);
const year = new Date().getFullYear();

const sitemap = [
  { label: t.footer.home, href: href('home', locale) },
  { label: t.nav.product, href: href('home', locale, '#producto') },
  { label: t.nav.about, href: href('home', locale, '#nosotros') },
  { label: t.nav.branches, href: href('branches', locale) },
];

/**
 * Redes sociales. PENDIENTE: las cuentas reales (nombre y URL) las debe dar el cliente.
 * Cada entrada: { label: 'Instagram', href: 'https://…' }. Mientras esté vacío se muestra un aviso.
 */
const social: { label: string; href: string }[] = [];

const legal = [
  { label: t.footer.privacy, href: href('privacy', locale) },
  { label: t.footer.cookies, href: href('cookies', locale) },
];
---

<footer class="site-footer">
  <div class="container inner">
    <div class="main">
      <nav class="sitemap" aria-labelledby="footer-sitemap">
        <h2 id="footer-sitemap">{t.footer.sitemap}</h2>
        <ul>
          {sitemap.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="wordmark">
        <Logo size="footer" />
      </div>

      <div class="connect">
        <section aria-labelledby="footer-social">
          <h2 id="footer-social">{t.footer.social}</h2>
          {social.length > 0 ? (
            <ul>
              {social.map((item) => (
                <li>
                  <a href={item.href} rel="noopener noreferrer" target="_blank">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="pending">{t.footer.comingSoon}</p>
          )}
        </section>

        <section aria-labelledby="footer-branches">
          <h2 id="footer-branches">{t.footer.branches}</h2>
          <ul>
            <li>
              <a href={href('branches', locale)}>{t.footer.viewLocations}</a>
            </li>
          </ul>
        </section>
      </div>
    </div>

    <div class="bottom">
      <p class="copyright">
        © {year} {t.site.name}. {t.footer.rights}
      </p>

      <nav aria-label={t.footer.legalNav}>
        <ul class="legal">
          {legal.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-footer);
    color: var(--text-on-footer);
    border-start-start-radius: var(--radius-lg);
    border-start-end-radius: var(--radius-lg);
  }

  .inner {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-16) var(--space-8);
  }

  /* Móvil: logo arriba; mapa del sitio y redes/sucursales en dos columnas debajo. */
  .main {
    display: grid;
    grid-template-areas:
      'logo logo'
      'sitemap connect';
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    align-items: start;
  }

  .wordmark {
    grid-area: logo;
  }

  .sitemap {
    grid-area: sitemap;
  }

  .connect {
    display: grid;
    grid-area: connect;
    gap: var(--space-8);
  }

  h2 {
    margin-block-end: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-body);
  }

  ul {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-target);
    color: var(--text-on-footer);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .pending {
    color: var(--text-on-footer);
    font-size: var(--text-sm);
  }

  /* Franja inferior: derechos reservados a la izquierda, avisos legales a la derecha. */
  .bottom {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid
      color-mix(in srgb, var(--text-on-footer) 25%, transparent);
    font-size: var(--text-sm);
  }

  .copyright {
    max-inline-size: none;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }

  .legal a {
    min-block-size: var(--tap-target);
    font-size: var(--text-sm);
  }

  /* Escritorio: mapa | logo | redes y sucursales. */
  @media (width >= 64rem) {
    .inner {
      padding-block-start: var(--space-24);
    }

    .main {
      grid-template-areas: 'sitemap logo connect';
      grid-template-columns: 1fr minmax(0, 30rem) 1fr;
      align-items: center;
      gap: var(--space-8);
    }

    /* El bloque derecho se alinea al borde del contenedor. */
    .connect {
      place-self: start end;
    }

    .sitemap {
      align-self: start;
    }

    .bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>

---
interface Props {
  /** Palabra acentuada en script (firma verbal de la marca). Con moderación. */
  accent?: string;
  level?: 'h1' | 'h2' | 'h3';
  /** `display`: titular de portada, más grande. */
  size?: 'section' | 'display';
  id?: string;
}

const { accent, level: Tag = 'h2', size = 'section', id } = Astro.props;
---

<Tag class:list={['section-title', size]} id={id}>
  <span class="caps">
    <slot />
  </span>
  {accent && (
    <>
      {' '}
      <span class="accent">{accent}</span>
    </>
  )}
</Tag>

<style>
  .section-title {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }

  .display {
    font-size: var(--text-display);
  }

  .caps {
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  /* Snell Roundhand es ilegible en tamaños pequeños: solo en titulares. */
  .accent {
    font-family: var(--font-script);
    font-size: 1.25em;
  }
</style>

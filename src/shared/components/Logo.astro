---
import { Image } from 'astro:assets';
import footerLogo from '../assets/logo-footer.jpg';

interface Props {
  /** `header`: marca compacta en la barra. `footer`: marca grande a ancho completo. */
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
const isDev = import.meta.env.DEV;
---

<!--
  HEADER: espacio reservado para el logo.
  El logo disponible es blanco sobre rosa: no se ve sobre el vidrio crema.
  Falta la versión en café/oliva sobre transparente, en SVG (manual §3).
-->
{size === 'footer' ? (
  <div class="footer">
    <Image
      src={footerLogo}
      alt="Soul matcha"
      format="webp"
      quality={100}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 75rem) 75rem, 100vw"
      loading="lazy"
    />
  </div>
) : (
  <span class:list={['logo', 'header', { dev: isDev }]} aria-hidden="true" />
)}

<style>
  .logo {
    display: block;
    border-radius: var(--radius-sm);
  }

  /* El logotipo mide mínimo 80.4 px en web (manual de identidad). */
  .header {
    inline-size: 5.5rem;
    block-size: 2.5rem;
  }

  /*
   * La imagen (1600×766) trae el logotipo blanco sobre un rosa liso (#DCB2BC) que
   * coincide con el fondo del footer (--surface-footer = Sweet Pink #DCB3BC, 1 nivel
   * de diferencia). Se muestra completa y sin recorte ni máscara: el logotipo llega
   * casi hasta los bordes verticales de la imagen y cualquier desvanecimiento lo corta.
   */
  .footer {
    inline-size: 100%;
    max-inline-size: 60rem;
    margin-inline: auto;
  }

  .footer :global(img) {
    inline-size: 100%;
    block-size: auto;
  }

  /* Solo en desarrollo: hace visible la reserva. En producción queda en blanco. */
  .dev {
    outline: 1px dashed currentcolor;
    outline-offset: -1px;
    opacity: 0.45;
  }
</style>

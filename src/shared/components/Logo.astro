---
import { Image } from 'astro:assets';
import footerLogo from '../assets/logo-footer.jpg';

interface Props {
  /** `header`: marca compacta en la barra. `footer`: marca grande a ancho completo. */
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
const isDev = import.meta.env.DEV;
---

<!--
  HEADER: espacio reservado para el logo.
  El logo disponible es blanco sobre café: no se ve sobre el vidrio crema.
  Falta la versión en café/oliva sobre transparente, en SVG (manual §3).
-->
{size === 'footer' ? (
  <div class="footer">
    <Image
      src={footerLogo}
      alt="Soul matcha"
      format="webp"
      quality={85}
      widths={[640, 960, 1280]}
      sizes="(min-width: 75rem) 75rem, 100vw"
      loading="lazy"
    />
  </div>
) : (
  <span class:list={['logo', 'header', { dev: isDev }]} aria-hidden="true" />
)}

<style>
  .logo {
    display: block;
    border-radius: var(--radius-sm);
  }

  /* El logotipo mide mínimo 80.4 px en web (manual de identidad). */
  .header {
    inline-size: 5.5rem;
    block-size: 2.5rem;
  }

  /*
   * La imagen del logo es cuadrada con el logotipo al centro. Se recorta a 4:3
   * (el logotipo ocupa ~46 % del alto, 14 % de margen) y se desvanecen los bordes: el fondo del JPEG
   * difiere 1-2 niveles del café del footer y así no se ve ninguna costura.
   */
  .footer {
    inline-size: 100%;
    max-inline-size: 60rem;
    margin-inline: auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    mask-image:
      linear-gradient(
        to right,
        transparent,
        var(--color-white) 12%,
        var(--color-white) 88%,
        transparent
      ),
      linear-gradient(
        to bottom,
        transparent,
        var(--color-white) 10%,
        var(--color-white) 90%,
        transparent
      );
    mask-composite: intersect;
  }

  .footer :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Solo en desarrollo: hace visible la reserva. En producción queda en blanco. */
  .dev {
    outline: 1px dashed currentcolor;
    outline-offset: -1px;
    opacity: 0.45;
  }
</style>

---
import { Image } from 'astro:assets';
import footerLogo from '../assets/logo-footer.jpg';
import logoBrown from '../assets/logo-brown.png';
import logoWhite from '../assets/logo-white.png';

interface Props {
  /** `header`: marca compacta en la barra. `footer`: marca grande a ancho completo. */
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
---

<!--
  HEADER: dos versiones del logo apiladas; se ve una u otra según el cristal (ver SiteHeader):
  - cristal CLARO  -> logo café/oliva (#6F6132), 5.2:1 sobre crema.
  - cristal OSCURO -> logo blanco, 17.9:1 sobre el cristal oscuro. El café ahí daría 2.9:1.
  Son PNG con transparencia (la agencia los entregó rasterizados dentro de un SVG): falta el SVG vectorial.
-->
{size === 'footer' ? (
  <div class="footer">
    <Image
      src={footerLogo}
      alt="Soul matcha"
      format="webp"
      quality={100}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 75rem) 75rem, 100vw"
      loading="lazy"
    />
  </div>
) : (
  <span class="header" aria-hidden="true">
    <Image
      class="on-light"
      src={logoBrown}
      alt=""
      format="webp"
      widths={[164, 246, 328]}
      sizes="82px"
      loading="eager"
    />
    <Image
      class="on-dark"
      src={logoWhite}
      alt=""
      format="webp"
      widths={[164, 246, 328]}
      sizes="82px"
      loading="eager"
    />
  </span>
)}

<style>
  /* El logotipo mide mínimo 80.4 px en web (manual de identidad): ver --logo-header-width. */
  .header {
    position: relative;
    display: block;
    inline-size: var(--logo-header-width);

    /* Proporción de los PNG (892×733): reserva el alto antes de que cargue la imagen. */
    aspect-ratio: 892 / 733;
  }

  .header :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    transition: opacity var(--duration-base) var(--ease-out-soft);
  }

  /* Por defecto (y sin JavaScript) se ve el logo café; el blanco aparece sobre cristal oscuro. */
  .header :global(.on-dark) {
    opacity: 0;
  }

  :global(.site-header[data-surface='dark']) .header :global(.on-light) {
    opacity: 0;
  }

  :global(.site-header[data-surface='dark']) .header :global(.on-dark) {
    opacity: 1;
  }

  /*
   * La imagen (1600×766) trae el logotipo blanco sobre un rosa liso (#DCB2BC) que
   * coincide con el fondo del footer (--surface-footer = Sweet Pink #DCB3BC, 1 nivel
   * de diferencia). Se muestra completa y sin recorte ni máscara: el logotipo llega
   * casi hasta los bordes verticales de la imagen y cualquier desvanecimiento lo corta.
   */
  .footer {
    inline-size: 100%;
    max-inline-size: 60rem;
    margin-inline: auto;
  }

  .footer :global(img) {
    inline-size: 100%;
    block-size: auto;
  }
</style>

---
interface Props {
  href: string;
  /**
   * `primary`: relleno matcha (acción).
   * `rose`: relleno rosa del footer con texto café profundo (5.2:1).
   * `secondary`: contorno claro, para fondos oscuros.
   * `ink`: café sólido con texto crema (7:1), para fondos rosas o claros donde `rose` no se ve.
   */
  variant?: 'primary' | 'rose' | 'secondary' | 'ink';
  /** `sm`: compacto (hero). */
  size?: 'md' | 'sm';
}

const { href, variant = 'primary', size = 'md' } = Astro.props;
---

<!-- Primary: blanco sobre matcha = 3.05:1, solo cumple AA por ser texto grande y en negrita. No reducir en `md`. -->
<a class:list={['button', variant, size]} href={href}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap-target);
    padding: var(--space-3) var(--space-8);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform var(--duration-base) var(--ease-out-soft),
      background-color var(--duration-base) var(--ease-out-soft);
  }

  /* Compacto: ~30 % más pequeño que `md` (texto 20 → 14 px). */
  .sm {
    min-block-size: var(--button-height-sm);
    padding: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
  }

  .primary {
    background: var(--action);
    color: var(--action-contrast);
  }

  .rose {
    background: var(--surface-footer);
    color: var(--text-on-rose);
  }

  .ink {
    background: var(--surface-inverse);
    color: var(--text-inverse);
  }

  .secondary {
    border-color: var(--text-inverse);
    background: transparent;
    color: var(--text-inverse);
  }

  .secondary:hover {
    background: var(--hover-tint-dark);
  }

  .button:hover {
    transform: translateY(calc(var(--space-1) * -1));
  }
</style>

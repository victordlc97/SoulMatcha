---
import '../styles/global.css';
import CookieBanner from '../shared/components/CookieBanner.astro';
import Loader from '../shared/components/Loader.astro';
import SiteFooter from '../shared/components/SiteFooter.astro';
import SiteHeader from '../shared/components/SiteHeader.astro';
import { withBase } from '../shared/url';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Soul Matcha: matcha premium con elegancia y lujo.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link
      rel="icon"
      href={withBase('icon-192.png')}
      type="image/png"
      sizes="192x192"
    />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Antes del primer pintado: si el loader ya se mostró en esta sesión, no lo muestres de nuevo. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('sm-loader-seen')) {
          document.documentElement.dataset.loader = 'done';
        }
      } catch {
        // Sin almacenamiento: se muestra el loader.
      }
    </script>
    <noscript>
      <style>
        .loader {
          display: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Loader />
    <a class="skip-link" href="#contenido">
      Ir al contenido
    </a>
    <SiteHeader />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
    <CookieBanner />
  </body>
</html>

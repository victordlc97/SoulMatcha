---
import '../styles/global.css';
import {
  getLocale,
  locales,
  routePath,
  useTranslations,
  type RouteKey,
} from '../i18n';
import CookieBanner from '../shared/components/CookieBanner.astro';
import Loader from '../shared/components/Loader.astro';
import SiteFooter from '../shared/components/SiteFooter.astro';
import SiteHeader from '../shared/components/SiteHeader.astro';
import { withBase } from '../shared/url';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Página actual. Con ella se generan los `hreflang` y el selector de idioma apunta a la misma página. */
  routeKey?: RouteKey;
}

const locale = getLocale(Astro);
const t = useTranslations(locale);

const {
  title,
  description = t.site.description,
  noindex = false,
  routeKey,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Versiones de esta página en cada idioma (para buscadores). `x-default` = español.
const alternates = routeKey
  ? locales.map((l) => ({
      locale: l,
      url: new URL(withBase(routePath(routeKey, l)), Astro.site),
    }))
  : [];
const xDefault = alternates.find((a) => a.locale === 'es');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={a.url} />
    ))}
    {xDefault && (
      <link rel="alternate" hreflang="x-default" href={xDefault.url} />
    )}
    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link
      rel="icon"
      href={withBase('icon-192.png')}
      type="image/png"
      sizes="192x192"
    />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Antes del primer pintado: si el loader ya se mostró en esta sesión, no lo muestres de nuevo. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('sm-loader-seen')) {
          document.documentElement.dataset.loader = 'done';
        }
      } catch {
        // Sin almacenamiento: se muestra el loader.
      }
    </script>
    <noscript>
      <style>
        .loader {
          display: none;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Loader />
    <a class="skip-link" href="#contenido">
      {t.a11y.skipToContent}
    </a>
    <SiteHeader routeKey={routeKey} />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
    <CookieBanner />
  </body>
</html>

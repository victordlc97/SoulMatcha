---
import { Picture } from 'astro:assets';
import heroImage from '../features/hero/hero.jpg';
import Hero from '../features/hero/Hero.astro';
import AboutSection from '../features/story/AboutSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Soul Matcha">
  <Hero>
    <!-- Decorativa (alt vacío): el h1 del Hero ya nombra la sección. Es el LCP, por eso eager + fetchpriority. -->
    <Picture
      slot="media"
      src={heroImage}
      alt=""
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </Hero>
  <AboutSection />
</BaseLayout>

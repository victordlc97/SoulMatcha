---
import { getLocale, useTranslations } from '../../i18n';
import SectionTitle from '../../shared/components/SectionTitle.astro';
import PhotoRail from '../gallery/PhotoRail.astro';

const t = useTranslations(getLocale(Astro));
---

<!--
  SECCIÓN "PRODUCTO". Destino del enlace "Producto" del menú.
  Las fotos salen de src/features/gallery/producto/: para sumar fotos (otras presentaciones),
  soltarlas en esa carpeta; aparecen solas al final del carril.
-->
<section id="producto" class="product" aria-labelledby="product-title">
  <div class="container intro">
    <SectionTitle id="product-title">{t.product.title}</SectionTitle>
    <p class="lead">{t.product.lead}</p>
  </div>

  <PhotoRail category="producto" />
</section>

<style>
  .product {
    padding-block: var(--space-16);
    scroll-margin-block-start: var(--space-16);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-8);
  }

  .lead {
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  @media (width >= 48rem) {
    .product {
      padding-block: var(--space-32);
    }
  }
</style>

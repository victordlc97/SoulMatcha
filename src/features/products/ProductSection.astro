---
import { getLocale, useTranslations } from '../../i18n';
import SectionTitle from '../../shared/components/SectionTitle.astro';
import GalleryGrid from '../gallery/GalleryGrid.astro';

const t = useTranslations(getLocale(Astro));
---

<!--
  SECCIÓN "PRODUCTO". Destino del botón principal del hero y del enlace "Producto" del menú.
  Las fotos salen de src/features/gallery/<categoría>/: para sumar fotos, soltarlas en su carpeta.
-->
<section id="producto" class="product" aria-labelledby="product-title">
  <div class="container">
    <SectionTitle id="product-title">{t.product.title}</SectionTitle>
    <div class="block">
      <GalleryGrid category="producto" />
    </div>

    <SectionTitle id="process-title" level="h3">
      {t.product.processTitle}
    </SectionTitle>
    <div class="block">
      <GalleryGrid category="proceso" />
    </div>
  </div>
</section>

<style>
  .product {
    padding-block: var(--space-16);
    scroll-margin-block-start: var(--space-16);
  }

  .block {
    margin-block: var(--space-8) var(--space-16);
  }

  .block:last-child {
    margin-block-end: 0;
  }

  @media (width >= 48rem) {
    .product {
      padding-block: var(--space-32);
    }
  }
</style>

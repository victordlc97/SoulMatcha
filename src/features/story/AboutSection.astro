---
import { Image } from 'astro:assets';
import { getLocale, useTranslations } from '../../i18n';
import SectionTitle from '../../shared/components/SectionTitle.astro';
import { galleryImages } from '../gallery/gallery';

const t = useTranslations(getLocale(Astro));
// Las dos primeras de gallery/historia/. El resto queda disponible para una galería de historia.
const [tall, square] = galleryImages('historia');
const alt = t.gallery.historia;
---

<!--
  SECCIÓN "NOSOTROS". Composición asimétrica: un texto de marca y dos fotografías.
  Pendiente de contenido del cliente: el bloque .copy por el texto real (idealmente desde src/content/).
-->
<section id="nosotros" class="about" aria-labelledby="about-title">
  <div class="container grid">
    <div class="copy">
      <SectionTitle id="about-title">{t.about.title}</SectionTitle>
      <p class="pending">{t.about.pending}</p>
    </div>

    {tall && (
      <Image
        class="frame tall"
        src={tall}
        alt={alt}
        format="webp"
        widths={[480, 800, 1200]}
        sizes="(min-width: 48rem) 33vw, 100vw"
        loading="lazy"
      />
    )}
    {square && (
      <Image
        class="frame square"
        src={square}
        alt={alt}
        format="webp"
        widths={[360, 640, 960]}
        sizes="(min-width: 48rem) 25vw, 100vw"
        loading="lazy"
      />
    )}
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-16);
    scroll-margin-block-start: var(--space-16);
  }

  .grid {
    display: grid;
    gap: var(--space-8);
  }

  .copy {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .pending {
    color: var(--text-secondary);
  }

  .frame {
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--surface-alt);
  }

  .tall {
    aspect-ratio: 4 / 5;
  }

  .square {
    aspect-ratio: 1;
  }

  @media (width >= 48rem) {
    .about {
      padding-block: var(--space-32);
    }

    /* Texto a la izquierda; dos fotos escalonadas a la derecha. */
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-8);
      align-items: start;
    }

    .copy {
      grid-column: 1 / span 4;
      position: sticky;
      inset-block-start: calc(var(--header-offset) + var(--space-24));
    }

    .tall {
      grid-column: 6 / span 4;
    }

    .square {
      grid-column: 10 / span 3;
      margin-block-start: var(--space-24);
    }
  }
</style>

---
import { getLocale, useTranslations } from '../../i18n';
import SectionTitle from '../../shared/components/SectionTitle.astro';
import { galleryImages } from '../gallery/gallery';
import Photo from '../gallery/Photo.astro';

const t = useTranslations(getLocale(Astro));
// Las dos primeras de gallery/historia/. El resto queda disponible para una galería de historia.
const [tall, square] = galleryImages('historia');
const alt = t.gallery.historia;
---

<!--
  SECCIÓN "NOSOTROS". Composición asimétrica: un texto de marca y dos fotografías.
  Texto: págs. 2 del deck de mayoreo (traducido al español; pendiente de revisión del cliente).
-->
<section id="nosotros" class="about" aria-labelledby="about-title">
  <div class="container grid">
    <div class="copy">
      <SectionTitle id="about-title">{t.about.title}</SectionTitle>
      <p>{t.about.story1}</p>
      <p>{t.about.story2}</p>
    </div>

    {tall && (
      <div class="tall">
        <Photo
          image={tall}
          alt={alt}
          group="historia"
          ratio="4 / 5"
          widths={[480, 800, 1200]}
          sizes="(min-width: 48rem) 33vw, 50vw"
        />
      </div>
    )}
    {square && (
      <div class="square">
        <Photo
          image={square}
          alt={alt}
          group="historia"
          ratio="1"
          widths={[360, 640, 960]}
          sizes="(min-width: 48rem) 25vw, 50vw"
        />
      </div>
    )}
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-16);
    scroll-margin-block-start: var(--space-16);
  }

  .grid {
    display: grid;
    gap: var(--space-8);
  }

  .copy {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  /* Móvil: el texto arriba y las dos fotos lado a lado, alineadas por abajo. Apiladas a ancho
     completo ocupaban casi dos pantallas. */
  @media (width < 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
      align-items: end;
    }

    .copy {
      grid-column: 1 / -1;
      margin-block-end: var(--space-4);
    }
  }

  @media (width >= 48rem) {
    .about {
      padding-block: var(--space-32);
    }

    /* Texto a la izquierda; dos fotos escalonadas a la derecha. */
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-8);
      align-items: start;
    }

    .copy {
      grid-column: 1 / span 4;
      position: sticky;
      inset-block-start: calc(var(--header-offset) + var(--space-24));
    }

    .tall {
      grid-column: 6 / span 4;
    }

    .square {
      grid-column: 10 / span 3;
      margin-block-start: var(--space-24);
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { getLocale, useTranslations } from '../../i18n';
import { galleryImages, type GalleryCategory } from './gallery';

interface Props {
  category: GalleryCategory;
}

const { category } = Astro.props;
const alt = useTranslations(getLocale(Astro)).gallery[category];
const images = galleryImages(category);
---

<!--
  Rejilla de una categoría; las fotos horizontales se recortan al centro (4:5). Alt común por
  categoría: cuando el cliente entregue descripciones por foto, pasar a un arreglo en src/content/.
-->
<ul class="grid">
  {images.map((image) => (
    <li>
      <Image
        src={image}
        alt={alt}
        format="webp"
        widths={[400, 640, 960]}
        sizes="(min-width: 64rem) 17rem, (min-width: 48rem) 33vw, 50vw"
        loading="lazy"
      />
    </li>
  ))}
</ul>

<style>
  /* Rejilla uniforme 4:5: crece ordenada cuando lleguen más fotos (sin huecos por proporciones). */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--surface-alt);
  }

  @media (width >= 48rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }

  @media (width >= 64rem) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

---
import { getLocale, useTranslations } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../gallery/Lightbox.astro';
import Hero from '../hero/Hero.astro';
import ProductSection from '../products/ProductSection.astro';
import AboutSection from '../story/AboutSection.astro';
import MissionBand from '../story/MissionBand.astro';
import OriginSection from '../story/OriginSection.astro';

/** Portada. La usan `/` (español) y `/en/` (inglés): el idioma lo resuelve Astro por la URL. */
const t = useTranslations(getLocale(Astro));
---

<BaseLayout title={t.site.name} routeKey="home">
  <Hero />
  <!--
    La página cuenta una historia, y las fotos viven DENTRO de cada parte (no hay una galería suelta):
    quiénes somos → de dónde viene el matcha → el producto → la misión. Mismo orden que el menú.
  -->
  <AboutSection />
  <OriginSection />
  <ProductSection />
  <MissionBand />
  <Lightbox />
</BaseLayout>
